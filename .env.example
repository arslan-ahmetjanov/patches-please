# Скопируйте файл в .env: cp .env.example .env
# .env попадает в .gitignore и в образ не копируется.
# Значения ниже — только для локального стенда. Для демо-стенда и защиты смените пароль.

APP_ENV=local
API_PORT=8000

# PostgreSQL
POSTGRES_USER=patches_please
POSTGRES_PASSWORD=patches_please_local
POSTGRES_DB=patches_please
POSTGRES_PORT=5432

# Строки подключения внутри сети Docker Compose
DATABASE_URL=postgresql+psycopg://patches_please:patches_please_local@postgres:5432/patches_please
REDIS_URL=redis://redis:6379/0

# DATABASE_URL выше — для контейнеров api и worker (хост postgres). Миграции с хоста
# запускаются без этой переменной и используют значение по умолчанию из patches_please/db.py
# (localhost:5432). Если меняете здесь пароль или порт, задайте DATABASE_URL и для
# миграций — пример в README, раздел «База данных и миграции».
